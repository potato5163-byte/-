      textarea.value = sampleNotice;
      updateCount();
      textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
      textarea.focus();
    });

    // File selection UI feedback
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) {
        fileNameText.textContent = `${file.name} (${(file.size / 1024 / 1024).toFixed(1)}MB)`;
        fileStatus.classList.remove('hidden');
      } else {
        fileStatus.classList.add('hidden');
      }
    });

    // CTA Tap Ripple / Transition Simulation
    submitBtn.addEventListener('click', () => {
      if (!textarea.value.trim() && (!fileInput.files || fileInput.files.length === 0)) {
        textarea.classList.add('ring-2', 'ring-error');
        textarea.focus();
        setTimeout(() => {
          textarea.classList.remove('ring-2', 'ring-error');
        }, 1500);
        return;
      }

      const originalHTML = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="material-symbols-outlined text-[20px] animate-spin text-secondary-fixed">progress_activity</span>
        <span class="text-label-md font-label-md text-on-primary">공고 분석 및 일정 정리 중...</span>
      `;
      
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalHTML;
      }, 1800);
    });
  })();
</script></main><nav class="fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.04)]" data-active-classes="text-secondary font-label-md"><div class="max-w-[440px] mx-auto flex justify-around items-center h-20 px-space-md"><a aria-current="page" class="flex flex-col items-center justify-center gap-1 w-20 h-14 rounded-xl transition-colors text-secondary font-label-md" data-path="공고-분석-입력" href="#"><span class="material-symbols-outlined text-[24px]">edit_note</span><span class="font-label-sm text-label-sm">정리하기</span></a><a class="flex flex-col items-center justify-center gap-1 w-20 h-14 rounded-xl text-on-surface-variant hover:text-on-surface transition-colors" data-path="내-공고-목록" href="#"><span class="material-symbols-outlined text-[24px]">bookmarks</span><span class="font-label-sm text-label-sm">내 공고</span></a></div></nav></body></html>